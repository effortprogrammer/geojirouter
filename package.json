{
  "name": "everyone-gateway",
  "version": "0.1.0",
  "description": "A local, free-only model gateway with sourced offers and honest limits.",
  "type": "module",
  "license": "MIT",
  "engines": { "bun": ">=1.3.0" },
  "bin": { "gateway": "./dist/cli.js" },
  "exports": { ".": "./src/index.ts" },
  "files": ["dist", "src", "data", "README.md", "LICENSE"],
  "scripts": {
    "test": "bun test",
    "check": "tsc --noEmit && biome check .",
    "build": "bun build src/cli.ts --target=bun --outfile=dist/cli.js && chmod +x dist/cli.js",
    "start": "bun src/cli.ts serve"
  },
  "dependencies": {
    "hono": "^4.12.5",
    "ky": "^1.10.0",
    "zod": "^4.4.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.0",
    "@types/bun": "1.3.14",
    "typescript": "^5.9.0"
  }
}
